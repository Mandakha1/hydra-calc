# ---- Deployment domain (Faza 7) ----
# Your registered domain, e.g. hydra.mn
DOMAIN=example.com
# Used by Caddy for Let's Encrypt ACME registration
ADMIN_EMAIL=you@example.com

# ---- Database (Faza 1) ----
# In docker-compose these come from postgres service defaults; override for local dev
DATABASE_URL=postgres://hydra:hydra@localhost:5432/hydra

# ---- Auth (Faza 2) ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-64-plus-random-chars
# Access token TTL (seconds). 15 minutes.
JWT_ACCESS_TTL=900
# Refresh token TTL (seconds). 30 days.
JWT_REFRESH_TTL=2592000
# Cookie domain (leave blank for localhost)
COOKIE_DOMAIN=

# ---- CORS (Faza 2) ----
# In prod set to https://${DOMAIN}; for local dev use http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Admin bootstrap (pnpm seed:admin) ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

# ---- Frontend (Vite) ----
# When running dev locally, point to backend origin. In prod, empty (same origin via Caddy).
VITE_API_BASE_URL=http://localhost:3000

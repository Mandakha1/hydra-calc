{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/db/seed-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/sensible": "5.6.0",
    "@fastify/swagger": "8.15.0",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "pg": "8.13.0",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "shared": "workspace:*",
    "tsx": "4.19.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "22.7.4",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "drizzle-kit": "0.24.2",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
